# Required: DashScope-compatible chat model
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=

# Required: legal web search
TAVILY_API_KEY=
TAVILY_MCP_URL=https://mcp.tavily.com/mcp/

# Required only if the image-upload feature should be available
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com

# Optional: use remote Qdrant retrieval in addition to the bundled local Chroma index
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=rag_knowledge_base
RAG_NAMESPACE=default

# Optional local path overrides
# LAW_DATABASE_PATH=db/law.db
# MEMORY_DATABASE_PATH=db/memory.db
# CHROMA_PATH=chroma_db
# LAW_NOTES_DIR=data/notes

# Set this to trusted browser origins only when serving the frontend separately.
# The Render setup serves frontend and API from the same origin, so leave blank.
# CORS_ALLOWED_ORIGINS=
